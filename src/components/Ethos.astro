---
import { site } from '../content/site';
---

<section class="ethos section" id="ethos" aria-labelledby="ethos-title">
	<div class="wrap ethos__inner">
		<p class="section__label reveal">Ethos</p>
		<h2 class="section__title reveal" id="ethos-title">{site.ethos.title}</h2>
		<div class="ethos__body reveal">
			{site.ethos.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</div>
</section>

<style>
	.ethos {
		border-block: 1px solid var(--color-line);
		background:
			radial-gradient(70% 80% at 0% 50%, var(--color-wash-a), transparent 55%),
			var(--color-paper);
	}

	.ethos__inner {
		max-width: 40rem;
	}

	.ethos__body {
		font-size: 1.12rem;
		color: var(--color-ink-muted);
	}

	.ethos__body p {
		margin: 0 0 1.15rem;
	}

	.ethos__body p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 799px) {
		.ethos {
			padding-block: 3.75rem;
		}

		.ethos__body {
			font-size: 1.05rem;
			line-height: 1.75;
		}

		.ethos__body p {
			margin-bottom: 1.35rem;
		}
	}
</style>
