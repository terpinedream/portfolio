---
import { site } from '../content/site';
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
	<div class="wrap">
		<p class="section__label reveal">Contact</p>
		<h2 class="section__title reveal" id="contact-title">Say hello</h2>
		<div class="contact__row reveal">
			<a class="contact__link" href={site.links.github} target="_blank" rel="noopener noreferrer">
				<span class="contact__kind">GitHub</span>
				<span class="contact__value">github.com/terpinedream</span>
			</a>
			{
				site.email ? (
					<a class="contact__link" href={`mailto:${site.email}`}>
						<span class="contact__kind">Email</span>
						<span class="contact__value">{site.email}</span>
					</a>
				) : null
			}
			<a class="contact__link" href={site.links.coffee} target="_blank" rel="noopener noreferrer">
				<span class="contact__kind">Support</span>
				<span class="contact__value">buymeacoffee.com/terpinedream</span>
			</a>
		</div>
	</div>
</section>

<footer class="footer">
	<div class="wrap footer__inner">
		<p>© {new Date().getFullYear()} {site.brand}</p>
		<p class="footer__note">Built with Astro · Static on GitHub Pages</p>
	</div>
</footer>

<style>
	.contact__row {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--color-line);
	}

	.contact__link {
		display: grid;
		gap: 0.25rem;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--color-line);
		text-decoration: none;
		transition: background 0.2s ease;
	}

	.contact__link:not(.contact__link--muted):hover {
		background: color-mix(in srgb, white 45%, transparent);
	}

	.contact__kind {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-slate-soft);
	}

	.contact__value {
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 2.5vw, 1.7rem);
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.contact__link--muted .contact__value {
		color: var(--color-slate-soft);
		font-size: 1rem;
		font-family: var(--font-body);
	}

	.footer {
		padding: var(--space-lg) 0 var(--space-xl);
		border-top: 1px solid var(--color-line);
	}

	.footer__inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		font-size: 0.88rem;
		color: var(--color-slate-soft);
	}

	.footer p {
		margin: 0;
	}

	@media (max-width: 719px) {
		.contact__link {
			grid-template-columns: 4.75rem minmax(0, 1fr);
			align-items: baseline;
			gap: 0.75rem;
			padding: 0.9rem 0;
		}

		.contact__value {
			font-size: clamp(0.95rem, 3.6vw, 1.15rem);
			overflow-wrap: anywhere;
		}
	}

	@media (min-width: 720px) {
		.contact__link {
			grid-template-columns: 7rem 1fr;
			align-items: baseline;
			gap: 1.5rem;
		}
	}
</style>
