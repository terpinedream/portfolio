---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import CommandPalette from '../../components/CommandPalette.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import { getProject, projects } from '../../content/projects';
import { site } from '../../content/site';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
	}));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
	return Astro.redirect(withBase());
}
---

<BaseLayout title={project.title} description={project.tagline}>
	<Nav />
	<main id="main" class="detail">
		<article class="wrap detail__article">
			<p class="detail__crumb">
				<a href={withBase('#work')}>Work</a>
				<span aria-hidden="true">/</span>
				<span>{project.title}</span>
			</p>
			<header class="detail__header" style={`--accent: ${project.accent}`}>
				<p class="detail__stars">{project.stars} GitHub stars</p>
				<h1>{project.title}</h1>
				<p class="detail__tagline">{project.tagline}</p>
			</header>
			{
				project.image ? (
					<figure
						class:list={[
							'detail__panel',
							'detail__panel--photo',
							project.imageFit === 'contain' && 'detail__panel--contain',
						]}
						style={`--accent: ${project.accent}`}
					>
						<img
							src={withBase(project.image)}
							alt={`${project.title} screenshot`}
							loading="lazy"
							decoding="async"
						/>
					</figure>
				) : (
					<div class="detail__panel" style={`--accent: ${project.accent}`} aria-hidden="true">
						<div class="detail__specimen">
							<span class="detail__glyph">{project.title.slice(0, 1).toLowerCase()}</span>
							<div class="detail__specimen-copy">
								<span class="detail__specimen-name">{project.title}</span>
								<span class="detail__specimen-rule"></span>
								<span class="detail__specimen-meta">{project.stack.join(' · ')}</span>
							</div>
						</div>
						<div class="detail__signal">
							<span></span>
							<span></span>
							<span></span>
						</div>
					</div>
				)
			}
			<div class="detail__body">
				{project.details.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			{
				project.gallery && project.gallery.length > 0 && (
					<ImageCarousel
						images={project.gallery}
						altPrefix={`${project.title} screenshot`}
						accent={project.accent}
					/>
				)
			}
			<ul class="detail__stack">
				{project.stack.map((item) => <li>{item}</li>)}
			</ul>
			<p class="detail__actions">
				<a class="detail__btn" href={project.repo} target="_blank" rel="noopener noreferrer"
					>View repository</a
				>
				{(project.links ?? []).map((link) => (
					<a class="detail__link" href={link.href} target="_blank" rel="noopener noreferrer">
						{link.label}
					</a>
				))}
				<a class="detail__link" href={withBase('#work')}>Back to work</a>
			</p>
		</article>
	</main>
	<footer class="detail__footer">
		<div class="wrap">
			<p>© {new Date().getFullYear()} {site.brand}</p>
		</div>
	</footer>
	<CommandPalette />
</BaseLayout>

<style>
	.detail {
		padding: 5rem 0 4rem;
	}

	@media (max-width: 719px) {
		.detail {
			padding: 4.25rem 0 2.5rem;
		}

		.detail__header h1 {
			font-size: clamp(1.85rem, 9vw, 2.6rem);
		}

		.detail__body {
			font-size: 0.98rem;
		}
	}

	.detail__article {
		max-width: 42rem;
	}

	.detail__crumb {
		display: flex;
		gap: 0.5rem;
		margin: 0 0 1.5rem;
		font-size: 0.88rem;
		color: var(--color-slate-soft);
	}

	.detail__crumb a {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
	}

	.detail__header h1 {
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: clamp(2.4rem, 6vw, 4rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.05;
	}

	.detail__stars {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-slate-soft);
	}

	.detail__tagline {
		margin: 0;
		font-size: 1.2rem;
		color: var(--color-ink-muted);
	}

	.detail__panel {
		position: relative;
		margin: 2rem 0;
		aspect-ratio: 16 / 7;
		overflow: hidden;
		border: 1px solid var(--color-line);
		background:
			radial-gradient(90% 120% at 100% 0%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 55%),
			linear-gradient(165deg, #f4f6f8 0%, var(--color-paper) 48%, var(--color-paper-deep) 100%);
	}

	.detail__panel::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--accent);
		z-index: 1;
	}

	.detail__panel--photo {
		margin: 2rem 0;
		background: var(--color-paper-deep);
	}

	.detail__panel--photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		display: block;
	}

	.detail__panel--contain {
		background: #0a0a0a;
	}

	.detail__panel--contain img {
		object-fit: contain;
		object-position: center;
	}

	.detail__specimen {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: end;
		gap: 1.5rem;
		padding: 1.5rem 1.75rem 1.35rem 1.75rem;
	}

	.detail__glyph {
		font-family: var(--font-display);
		font-size: clamp(4rem, 12vw, 7rem);
		font-weight: 500;
		line-height: 0.85;
		letter-spacing: -0.06em;
		color: color-mix(in srgb, var(--accent) 72%, var(--color-ink));
	}

	.detail__specimen-copy {
		display: grid;
		gap: 0.45rem;
		align-content: end;
		padding-bottom: 0.35rem;
	}

	.detail__specimen-name {
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 2.5vw, 1.6rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		color: var(--color-ink);
	}

	.detail__specimen-rule {
		display: block;
		height: 1px;
		width: min(16rem, 100%);
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--accent) 55%, transparent),
			var(--color-line) 55%,
			transparent
		);
	}

	.detail__specimen-meta {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-slate-soft);
	}

	.detail__signal {
		position: absolute;
		top: 1.15rem;
		right: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		width: 2.6rem;
	}

	.detail__signal span {
		display: block;
		height: 2px;
		border-radius: 1px;
		background: color-mix(in srgb, var(--accent) 45%, var(--color-slate-soft));
		opacity: 0.55;
	}

	.detail__signal span:nth-child(1) {
		width: 100%;
	}

	.detail__signal span:nth-child(2) {
		width: 72%;
		opacity: 0.35;
	}

	.detail__signal span:nth-child(3) {
		width: 48%;
		opacity: 0.25;
	}

	.detail__body {
		margin: 0 0 1.5rem;
		font-size: 1.08rem;
		color: var(--color-ink-muted);
	}

	.detail__body p {
		margin: 0 0 1.15rem;
	}

	.detail__body p:last-child {
		margin-bottom: 0;
	}

	.detail__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
	}

	.detail__stack li {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding-bottom: 0.1rem;
		border-bottom: 1px solid var(--color-line);
		color: var(--color-slate);
	}

	.detail__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin: 0;
	}

	.detail__btn {
		display: inline-flex;
		padding: 0.75rem 1.2rem;
		background: var(--color-ink);
		color: var(--color-paper);
		font-weight: 600;
		text-decoration: none;
		border-radius: 2px;
	}

	.detail__link {
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
	}

	.detail__footer {
		padding: 1.5rem 0 2.5rem;
		border-top: 1px solid var(--color-line);
		font-size: 0.88rem;
		color: var(--color-slate-soft);
	}

	.detail__footer p {
		margin: 0;
	}
</style>
